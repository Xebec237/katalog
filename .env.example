# ==============================================================================
# Katalog Backend — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs
# ==============================================================================

# --- Application ---
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
API_URL=http://localhost:3000/api
PUBLIC_CATALOG_URL=http://localhost:3000/c

# --- Base de données ---
DATABASE_URL=postgresql://katalog:katalog_dev_password@localhost:5432/katalog?schema=public
REDIS_URL=redis://localhost:6379

# --- Sécurité ---
JWT_SECRET=change-me-to-a-random-64-char-string
JWT_REFRESH_SECRET=change-me-to-another-random-64-char-string
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
SESSION_SECRET=change-me-session-secret
TWO_FA_ENCRYPTION_KEY=generate-a-64-hex-char-key-for-aes-256

# --- Auth Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# --- Stockage (S3-compatible) ---
STORAGE_PROVIDER=s3
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=katalog-images
STORAGE_PUBLIC_URL=

# --- Intelligence Artificielle ---
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# --- Paiement (À CONNECTER) ---
PAYMENT_PROVIDER=cinetpay

# Stripe (cartes / diaspora)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# CinetPay (Mobile Money)
CINETPAY_API_KEY=
CINETPAY_SITE_ID=

# NotchPay
NOTCHPAY_API_KEY=

# PawaPay
PAWAPAY_API_KEY=

# --- Email ---
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM=Katalog <noreply@katalog.cm>

# --- Rate Limiting ---
THROTTLE_SHORT_TTL=1
THROTTLE_SHORT_LIMIT=10
THROTTLE_MEDIUM_TTL=60
THROTTLE_MEDIUM_LIMIT=100
THROTTLE_LONG_TTL=900
THROTTLE_LONG_LIMIT=1000

# --- Analytics ---
ANALYTICS_DEDUP_WINDOW_MINUTES=30
ANALYTICS_RATE_LIMIT_PER_MINUTE=60
